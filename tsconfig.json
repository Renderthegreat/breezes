{
	"compilerOptions": {
		"target": "esnext",

		"module": "esnext",
		"moduleResolution": "bundler",

		"rootDirs": [
			"src",
			"tests",
		],
		"rootDir": ".",
		"paths": {
			"#~/*": [
				"./src/*.js",
			],
			"#tests/*": [
				"./tests/*.js",
			],
			"#assets/*": [
				"./assets/*.js"
			],
		},

		"resolveJsonModule": true,
		"experimentalDecorators": true,

		"outDir": "dist",

		"strict": true,
		"strictNullChecks": true,
		"skipLibCheck": true,

		"declaration": true,

		"types": [
			"node",
		],
	},
}